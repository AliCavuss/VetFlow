@model PatientRecord
@{
    var p = Model.Patient;
    DateTime today = ViewBag.Today;
    var vets = (IReadOnlyList<Veterinarian>)ViewBag.Veterinarians;
    ViewData["Title"] = p.Name;
    var weights = Model.WeightHistory;
}
<nav class="crumbs"><a asp-action="Index">Patients</a> / @p.Name</nav>

<section class="patient-hero">
    <div class="pet-avatar pet-avatar-lg species-@p.Species.ToString().ToLowerInvariant()">@(p.Name[..1])</div>
    <div class="min-w-0 flex-grow-1">
        <h1 class="mb-1">@p.Name @if (p.IsDeceased) { <span class="badge badge-soft-secondary align-middle">Deceased</span> }</h1>
        <div class="hero-facts">
            <span><i class="bi @Ui.SpeciesIcon(p.Species)"></i> @p.Species · @(p.Breed ?? "Unknown breed")</span>
            <span>@Ui.SexSymbol(p.Sex, p.IsNeutered)</span>
            <span><i class="bi bi-cake2"></i> @p.Age(today) @(p.DateOfBirth.HasValue ? $"({Ui.Date(p.DateOfBirth)})" : "")</span>
            <span><i class="bi bi-speedometer2"></i> @(p.LastWeightKg.HasValue ? $"{p.LastWeightKg:0.##} kg" : "No weight")</span>
            @if (p.MicrochipNumber is not null)
            {
                <span title="@VetFlow.Domain.Common.MicrochipNumber.DescribePrefix(p.MicrochipNumber)"><i class="bi bi-cpu"></i> <span class="font-monospace">@p.MicrochipNumber</span></span>
            }
        </div>
        <div class="small mt-1">Owner: <a asp-controller="Owners" asp-action="Details" asp-route-id="@p.OwnerId">@p.Owner.FullName</a> · @Ui.Phone(p.Owner.Phone)</div>
    </div>
    <div class="d-flex gap-2 flex-wrap align-self-start">
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@p.Id"><i class="bi bi-pencil"></i> Edit</a>
        @if (!p.IsDeceased)
        {
            <a class="btn btn-outline-primary" asp-controller="Appointments" asp-action="Create" asp-route-patientId="@p.Id"><i class="bi bi-calendar-plus"></i> Book</a>
            if (User.IsClinical())
            {
                <form asp-controller="Visits" asp-action="StartWalkIn" method="post" class="d-flex gap-1">
                    <input type="hidden" name="patientId" value="@p.Id" />
                    <select name="veterinarianId" class="form-select" aria-label="Veterinarian">
                        @foreach (var v in vets)
                        {
                            <option value="@v.Id">@v.DisplayName</option>
                        }
                    </select>
                    <button class="btn btn-primary text-nowrap" type="submit"><i class="bi bi-play-fill"></i> Walk-in exam</button>
                </form>
            }
        }
    </div>
</section>

<partial name="_AllergyAlert" model="p" />

<div class="row g-4">
    <div class="col-xl-7">
        <section class="panel">
            <div class="panel-head"><h2>Medical history</h2><span class="text-muted small">@Model.Visits.Count visit(s)</span></div>
            @if (Model.Visits.Count == 0)
            {
                <div class="empty-state">No visits recorded yet.</div>
            }
            <ol class="history">
                @foreach (var v in Model.Visits)
                {
                    <li class="@(v.IsOpen ? "is-open" : "")">
                        <div class="history-date">@Ui.Date(v.StartedAt)<span>@Ui.Time(v.StartedAt)</span></div>
                        <div class="history-body min-w-0">
                            <div class="d-flex justify-content-between gap-2">
                                <a class="fw-semibold" asp-controller="Visits" asp-action="Details" asp-route-id="@v.Id">@(v.Assessment ?? v.Subjective ?? "Examination")</a>
                                @if (v.IsOpen) { <span class="badge badge-soft-info">In progress</span> }
                            </div>
                            <div class="small text-muted">@v.Veterinarian.DisplayName @(v.WeightKg.HasValue ? $"· {v.WeightKg:0.##} kg" : "") @(v.TemperatureC.HasValue ? $"· {v.TemperatureC:0.0} °C" : "")</div>
                            @if (!string.IsNullOrEmpty(v.Plan))
                            {
                                <div class="small mt-1"><strong>Plan:</strong> @v.Plan</div>
                            }
                            @if (v.Items.Count > 0)
                            {
                                <div class="small text-muted mt-1">@string.Join(" · ", v.Items.Select(i => i.Description))</div>
                            }
                        </div>
                    </li>
                }
            </ol>
        </section>
    </div>

    <div class="col-xl-5 d-flex flex-column gap-4">
        <section class="panel">
            <div class="panel-head"><h2>Vaccination status</h2></div>
            @if (Model.CurrentVaccinations.Count == 0)
            {
                <div class="text-muted small">No vaccinations recorded.</div>
            }
            <ul class="plain-list">
                @foreach (var v in Model.CurrentVaccinations)
                {
                    var status = v.DueStatus(today);
                    <li>
                        <div class="min-w-0">
                            <div class="fw-semibold">@v.VaccineType.Name</div>
                            <div class="small text-muted">Given @Ui.Date(v.AdministeredOn) @(v.BatchNumber is null ? "" : "· batch " + v.BatchNumber)</div>
                        </div>
                        <div class="text-end">
                            <span class="badge @Ui.DueBadge(status)">@status.DisplayName()</span>
                            <div class="small text-muted">next @Ui.Date(v.NextDueOn)</div>
                        </div>
                    </li>
                }
            </ul>
        </section>

        <section class="panel">
            <div class="panel-head"><h2>Upcoming appointments</h2></div>
            <ul class="plain-list">
                @if (Model.UpcomingAppointments.Count == 0)
                {
                    <li class="text-muted">None booked.</li>
                }
                @foreach (var a in Model.UpcomingAppointments)
                {
                    <li>
                        <a asp-controller="Appointments" asp-action="Details" asp-route-id="@a.Id">@Ui.DateAndTime(a.StartsAt)</a>
                        <span class="small">@a.Type.DisplayName() · @a.Veterinarian.DisplayName</span>
                        <span class="badge @Ui.AppointmentBadge(a.Status)">@a.Status.DisplayName()</span>
                    </li>
                }
            </ul>
        </section>

        @if (weights.Count >= 2)
        {
            <section class="panel">
                <div class="panel-head"><h2>Weight trend</h2></div>
                <div class="chart-box chart-box-sm"><canvas id="weight-chart" aria-label="Weight over time"></canvas></div>
            </section>
        }
    </div>
</div>

@section Scripts {
    @if (weights.Count >= 2)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.js"></script>
        <script>
            window.vetflowWeights = {
                labels: @Json.Serialize(weights.Select(w => w.Date.ToString("dd.MM.yy"))),
                values: @Json.Serialize(weights.Select(w => w.Kg))
            };
        </script>
        <script src="~/js/patient.js" asp-append-version="true"></script>
    }
}
