@model PatientFormModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? $"Edit {Model.Name}" : "New patient";
}
<nav class="crumbs"><a asp-controller="Owners" asp-action="Details" asp-route-id="@Model.OwnerId">@Model.OwnerName</a> / @ViewData["Title"]</nav>
<div class="page-head"><div><h1>@ViewData["Title"]</h1><p class="text-muted mb-0">Owner: @Model.OwnerName</p></div></div>
<section class="panel form-panel">
    <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="OwnerId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="row g-3">
            <div class="col-md-4"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
            <div class="col-md-4"><label asp-for="Species" class="form-label"></label><select asp-for="Species" asp-items="Ui.EnumOptions<Species>(Model.Species)" class="form-select"></select></div>
            <div class="col-md-4"><label asp-for="Breed" class="form-label"></label><input asp-for="Breed" class="form-control" /></div>
            <div class="col-md-4"><label asp-for="Sex" class="form-label"></label><select asp-for="Sex" asp-items="Ui.EnumOptions<Sex>(Model.Sex)" class="form-select"></select></div>
            <div class="col-md-4"><label asp-for="DateOfBirth" class="form-label"></label><input asp-for="DateOfBirth" class="form-control" /><span asp-validation-for="DateOfBirth" class="text-danger small"></span></div>
            <div class="col-md-4"><label asp-for="Color" class="form-label"></label><input asp-for="Color" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="MicrochipNumber" class="form-label"></label><input asp-for="MicrochipNumber" class="form-control font-monospace" placeholder="792 097 000 123 456" inputmode="numeric" /><span asp-validation-for="MicrochipNumber" class="text-danger small"></span></div>
            <div class="col-md-6 d-flex align-items-end gap-4">
                <div class="form-check"><input asp-for="IsNeutered" class="form-check-input" /><label asp-for="IsNeutered" class="form-check-label"></label></div>
                @if (isEdit)
                {
                    <div class="form-check"><input asp-for="IsDeceased" class="form-check-input" /><label asp-for="IsDeceased" class="form-check-label"></label></div>
                }
            </div>
            <div class="col-12"><label asp-for="Allergies" class="form-label"></label><textarea asp-for="Allergies" class="form-control" rows="2" placeholder="Shown as a warning on every clinical screen"></textarea></div>
        </div>
        <div class="mt-4 d-flex gap-2">
            <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg"></i> Save</button>
            <a class="btn btn-outline-secondary" href="@(isEdit ? Url.Action("Details", new { id = Model.Id }) : Url.Action("Details", "Owners", new { id = Model.OwnerId }))">Cancel</a>
        </div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
