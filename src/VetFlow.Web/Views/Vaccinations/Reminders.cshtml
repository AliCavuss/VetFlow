@model IReadOnlyList<Reminder>
@{ ViewData["Title"] = "SMS reminders"; }
<nav class="crumbs"><a asp-action="Index">Vaccinations</a> / SMS reminders</nav>
<div class="page-head">
    <div><h1>SMS reminders</h1><p class="text-muted mb-0">A background job runs every hour: boosters due within 7 days and appointments tomorrow, only for owners who gave consent. Each event is reminded once.</p></div>
    @if (User.IsAdmin())
    {
        <form asp-action="RunReminders" method="post"><button class="btn btn-primary" type="submit"><i class="bi bi-send"></i> Run now</button></form>
    }
</div>
<section class="panel p-0">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Created</th><th>Type</th><th>Owner</th><th>Message</th><th>Status</th></tr></thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="5" class="empty-state">No reminders yet – the first run starts about 20 seconds after the application starts.</td></tr>
            }
            @foreach (var r in Model)
            {
                <tr>
                    <td class="small text-nowrap">@Ui.DateAndTime(r.CreatedAt)</td>
                    <td class="small">@r.Type.DisplayName()</td>
                    <td class="small"><a asp-controller="Owners" asp-action="Details" asp-route-id="@r.OwnerId">@r.Owner.FullName</a><div class="text-muted">@Ui.Phone(r.Recipient)</div></td>
                    <td class="small">@r.Message</td>
                    <td><span class="badge @(r.Status == ReminderStatus.Sent ? "badge-soft-success" : r.Status == ReminderStatus.Failed ? "badge-soft-danger" : "badge-soft-secondary")">@r.Status</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
