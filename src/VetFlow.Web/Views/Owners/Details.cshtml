@model OwnerDetailsViewModel
@{
    var o = Model.Owner;
    ViewData["Title"] = o.FullName;
    var today = DateTime.Today;
}
<nav class="crumbs"><a asp-action="Index">Owners</a> / @o.FullName</nav>
<div class="page-head">
    <div>
        <h1>@o.FullName</h1>
        <p class="text-muted mb-0"><i class="bi bi-telephone"></i> @Ui.Phone(o.Phone) @(o.Email is null ? "" : " · " + o.Email) @(o.Address is null ? "" : " · " + o.Address)</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@o.Id"><i class="bi bi-pencil"></i> Edit</a>
        @if (User.IsBilling())
        {
            <form asp-controller="Invoices" asp-action="CreateForOwner" method="post">
                <input type="hidden" name="ownerId" value="@o.Id" />
                <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-receipt"></i> Counter sale</button>
            </form>
        }
        <a class="btn btn-primary" asp-controller="Patients" asp-action="Create" asp-route-ownerId="@o.Id"><i class="bi bi-plus-lg"></i> Add patient</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <section class="panel">
            <div class="panel-head"><h2>Patients (@o.Patients.Count)</h2></div>
            <div class="pet-grid">
                @foreach (var p in o.Patients.OrderBy(p => p.IsDeceased).ThenBy(p => p.Name))
                {
                    <a class="pet-card @(p.IsDeceased ? "is-deceased" : "")" asp-controller="Patients" asp-action="Details" asp-route-id="@p.Id">
                        <div class="pet-avatar species-@p.Species.ToString().ToLowerInvariant()">@(p.Name[..1])</div>
                        <div class="min-w-0">
                            <div class="fw-semibold">@p.Name @if (!string.IsNullOrEmpty(p.Allergies)) { <i class="bi bi-exclamation-triangle-fill text-warning" title="Allergies"></i> }</div>
                            <div class="small text-muted">@p.Species · @(p.Breed ?? "—") · @p.Age(today)</div>
                        </div>
                    </a>
                }
            </div>
        </section>
        @if (!string.IsNullOrEmpty(o.Notes))
        {
            <section class="panel mt-4"><div class="panel-head"><h2>Notes</h2></div><p class="mb-0" style="white-space:pre-line">@o.Notes</p></section>
        }
    </div>
    <div class="col-lg-5">
        <section class="panel">
            <div class="panel-head"><h2>Account</h2><span class="fw-bold @(Model.OpenBalance > 0 ? "text-danger" : "text-success")">@Ui.Money(Model.OpenBalance) open</span></div>
            <ul class="plain-list">
                @if (Model.Invoices.Count == 0)
                {
                    <li class="text-muted">No invoices yet.</li>
                }
                @foreach (var i in Model.Invoices)
                {
                    <li>
                        <a asp-controller="Invoices" asp-action="Details" asp-route-id="@i.Id">@(i.Number ?? "Draft")</a>
                        <span class="small text-muted">@Ui.Date(i.IssuedAt ?? i.CreatedAt)</span>
                        <span>@Ui.Money(i.Total)</span>
                        <span class="badge @Ui.InvoiceBadge(i.Status)">@i.Status.DisplayName()</span>
                    </li>
                }
            </ul>
            <div class="small text-muted mt-2">
                SMS reminders: @(o.ReminderConsent ? "consent given (KVKK)" : "no consent – no reminders are sent")
            </div>
        </section>
    </div>
</div>
