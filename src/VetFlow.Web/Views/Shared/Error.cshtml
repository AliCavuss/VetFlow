@model ErrorViewModel
@{ ViewData["Title"] = "Error"; }
<div class="empty-state my-5">
    <i class="bi bi-bandaid display-5 text-danger"></i>
    <h1 class="h4 mt-3">Something went wrong</h1>
    <p class="text-muted">An unexpected error occurred. Request ID: <code>@(Model?.RequestId)</code></p>
    <a class="btn btn-primary" href="/">Back to today</a>
</div>
