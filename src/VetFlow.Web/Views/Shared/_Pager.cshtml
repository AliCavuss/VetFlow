@model IPagedResult
@if (Model.TotalPages > 1)
{
    <nav class="d-flex justify-content-between align-items-center mt-3" aria-label="Pages">
        <span class="text-muted small">Page @Model.Page of @Model.TotalPages · @Model.TotalCount records</span>
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.HasPrevious ? "" : "disabled")"><a class="page-link" href="@Context.Request.WithQuery("page", (Model.Page - 1).ToString())">Previous</a></li>
            <li class="page-item @(Model.HasNext ? "" : "disabled")"><a class="page-link" href="@Context.Request.WithQuery("page", (Model.Page + 1).ToString())">Next</a></li>
        </ul>
    </nav>
}
else if (Model.TotalCount > 0)
{
    <div class="text-muted small mt-3">@Model.TotalCount records</div>
}
